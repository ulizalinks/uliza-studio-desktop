{
  "name": "uliza-studio-desktop",
  "productName": "Uliza Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Uliza Events design studio for Windows",
  "author": "Uliza Events",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ulizaevents.studio",
    "productName": "Uliza Studio",
    "copyright": "Uliza Events",
    "files": [
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Uliza-Studio-Setup.${ext}",
      "shortcutName": "Uliza Studio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ulizalinks",
        "repo": "uliza-studio-desktop",
        "releaseType": "release"
      }
    ]
  },
  "repository": "https://github.com/ulizalinks/uliza-studio-desktop"
}
